# Copy to .env.local for local dev, or set these in the Railway service variables.
# Do NOT commit real values — .env*.local is gitignored.

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- App URL (optional) ---
# Public base URL of the deployment, e.g. https://your-app.up.railway.app
# Auth redirects already use the incoming request origin, so this is only
# needed if you later build absolute URLs server-side.
NEXT_PUBLIC_APP_URL=

# --- Notes ---
# PORT: provided automatically by Railway — do not set it manually.
# NEXTAUTH_SECRET: not used. This app authenticates via Supabase Auth, not
#   NextAuth, so no NextAuth secret is required.
